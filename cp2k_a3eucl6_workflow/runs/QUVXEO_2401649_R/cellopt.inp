&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 300
    MAX_FORCE 4.5E-4
    RMS_FORCE 3.0E-4
  &END GEO_OPT
  &CELL_OPT
    OPTIMIZER BFGS
    MAX_ITER 120
    TYPE DIRECT_CELL_OPT
    KEEP_ANGLES .FALSE.
    KEEP_SYMMETRY .FALSE.
    MAX_DR 3.0E-3
  &END CELL_OPT
  &PRINT
    &TRAJECTORY
      FORMAT XYZ
      &EACH
        GEO_OPT 1
        CELL_OPT 1
      &END EACH
    &END TRAJECTORY
    &CELL
      &EACH
        GEO_OPT 1
        CELL_OPT 1
      &END EACH
    &END CELL
  &END PRINT
&END MOTION
