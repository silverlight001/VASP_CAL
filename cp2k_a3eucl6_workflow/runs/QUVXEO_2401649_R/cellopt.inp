&GLOBAL
  PROJECT QUVXEO_R
  RUN_TYPE CELL_OPT
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_A3EUCL6
    POTENTIAL_FILE_NAME POTENTIAL_A3EUCL6
    &MGRID
      CUTOFF 300
      REL_CUTOFF 40
    &END MGRID
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 120
      &OT
        PRECONDITIONER FULL_SINGLE_INVERSE
        MINIMIZER DIIS
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-6
        MAX_SCF 8
      &END OUTER_SCF
    &END SCF
    &XC
